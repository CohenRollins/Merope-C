[Unit]
Description=Merope-C gallery metadata and private admin backend
After=network.target

[Service]
Type=simple
User=cococr
Group=cococr
WorkingDirectory=/home/cococr/Merope-C
ExecStart=/usr/bin/python3 /home/cococr/Merope-C/admin/server.py run
Restart=on-failure
RestartSec=5
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ReadWritePaths=/home/cococr/.local/share/merope-c /home/cococr/.config/merope-c /var/www/merope-c/uploads

[Install]
WantedBy=multi-user.target
